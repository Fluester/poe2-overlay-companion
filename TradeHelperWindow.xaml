<Window x:Class="Poe2OverlayCompanion.TradeHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="405"
        SizeToContent="Height"
        Background="#FF212529">

    <Border Background="#FF212529" BorderBrush="#FF495057" BorderThickness="1" Padding="10,8">
        <StackPanel>
            <!-- Верхній рядок: Заголовок, Навігація черги, Закрити -->
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,6">
                <TextBlock x:Name="TitleText" Text="Trade Helper" Foreground="#FF6EA8FE" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="‹" Width="24" Height="20" Background="#FF2B3035" Foreground="#FFDEE2E6" BorderBrush="#FF495057" Margin="0,0,2,0" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Prev_Click"/>
                    <TextBlock x:Name="CountText" Text="0/0" Foreground="#FFADB5BD" FontSize="10.5" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Content="›" Width="24" Height="20" Background="#FF2B3035" Foreground="#FFDEE2E6" BorderBrush="#FF495057" Margin="0,0,5,0" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Next_Click"/>
                    <Button Content="✕" Width="22" Height="20" Background="#FF2C0B0E" Foreground="#FFEA868F" BorderBrush="#FF842029" FontSize="10" Cursor="Hand" Focusable="False" Click="DismissCurrent_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Інформація про запит -->
            <Border Background="#FF16191D" BorderBrush="#FF343A40" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,7">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="PlayerText" Text="@Player" Foreground="#FF75B798" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="PriceText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="" Foreground="#FFFFDA6A" FontWeight="SemiBold" FontSize="11.5"/>
                    </DockPanel>
                    <TextBlock x:Name="ItemText" Text="" Foreground="#FFDEE2E6" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="StashText" Text="" Foreground="#FF6EDFF6" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Кнопки 1-клік (Bootstrap) -->
            <WrapPanel>
                <Button x:Name="BtnInvite" Content="Invite" Padding="8,4" Margin="0,0,4,3" Background="#FF198754" Foreground="#FFFFFFFF" BorderBrush="#FF198754" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Focusable="False" Click="Invite_Click"/>
                <Button x:Name="BtnTrade" Content="Trade" Padding="8,4" Margin="0,0,4,3" Background="#FF0D6EFD" Foreground="#FFFFFFFF" BorderBrush="#FF0D6EFD" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Focusable="False" Click="Trade_Click"/>
                <Button x:Name="BtnHideout" Content="Hideout" Padding="8,4" Margin="0,0,4,3" Background="#FF2B3035" Foreground="#FFDEE2E6" BorderBrush="#FF495057" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Hideout_Click"/>
                <Button x:Name="BtnWait" Content="Wait" Padding="7,4" Margin="0,0,4,3" Background="#FF2B3035" Foreground="#FFFFDA6A" BorderBrush="#FF495057" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Wait_Click"/>
                <Button x:Name="BtnThanks" Content="Thx" Padding="7,4" Margin="0,0,4,3" Background="#FF2B3035" Foreground="#FF6EDFF6" BorderBrush="#FF495057" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Thanks_Click"/>
                <Button x:Name="BtnSold" Content="Sold" Padding="7,4" Margin="0,0,4,3" Background="#FFDC3545" Foreground="#FFFFFFFF" BorderBrush="#FFDC3545" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Sold_Click"/>
                <Button x:Name="BtnKick" Content="Kick" Padding="7,4" Margin="0,0,0,3" Background="#FF2B3035" Foreground="#FFADB5BD" BorderBrush="#FF495057" FontSize="10.5" Cursor="Hand" Focusable="False" Click="Kick_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
