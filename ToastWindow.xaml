<Window x:Class="Poe2OverlayCompanion.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420">
    <Border x:Name="CardBorder"
            Background="#FA212529"
            BorderBrush="#FF495057"
            BorderThickness="1"
            CornerRadius="6"
            Padding="13,9"
            Margin="4">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="#FF6EA8FE"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="#FFDEE2E6"
                       TextWrapping="Wrap"
                       LineHeight="17"/>
        </StackPanel>
    </Border>
</Window>
