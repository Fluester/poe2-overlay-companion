<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>Poe2OverlayCompanion</AssemblyName>
    <RootNamespace>Poe2OverlayCompanion</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <AssemblyTitle>PoE 2 Overlay Companion</AssemblyTitle>
    <Product>PoE 2 Overlay Companion</Product>
    <Authors>Poe2OverlayCompanion</Authors>
    <Description>Universal Path of Exile 2 desktop overlay with build planner, interactive passive tree, item evaluator, AI loot filter, farm tracker, and update monitor.</Description>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DefaultItemExcludes>$(DefaultItemExcludes);Poe2OverlayCompanion.Tests\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\poe2_tree_05.bin.gz" WithCulture="false" LogicalName="Poe2OverlayCompanion.Assets.poe2_tree_05.bin.gz" />
    <EmbeddedResource Include="Assets\poe2_gems_05.json.gz" WithCulture="false" LogicalName="Poe2OverlayCompanion.Assets.poe2_gems_05.json.gz" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
