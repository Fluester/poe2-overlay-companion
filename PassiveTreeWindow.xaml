<Window x:Class="Poe2OverlayCompanion.PassiveTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Poe2OverlayCompanion.Controls"
        Title="PoE 2 Passive Tree Viewer"
        Width="980" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C0E12" Foreground="#FFE6E8ED" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF141820" BorderBrush="#FF232834" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel>
                <TextBlock x:Name="TitleText" Text="Passive Tree" Foreground="#FFD4B06A" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+" Padding="10,3" Margin="0,0,4,0" Background="#FF1A1F29" Foreground="#FFE6E8ED" BorderBrush="#FF2D3443" Click="ZoomIn_Click"/>
                    <Button Content="−" Padding="10,3" Margin="0,0,4,0" Background="#FF1A1F29" Foreground="#FFE6E8ED" BorderBrush="#FF2D3443" Click="ZoomOut_Click"/>
                    <Button Content="⌖ Центр" Padding="10,3" Background="#FFC49E57" Foreground="#FF111318" FontWeight="SemiBold" BorderBrush="#FFD8B872" Click="Fit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <controls:PassiveTreeView x:Name="FullTreeCanvas" Grid.Row="1"/>
    </Grid>
</Window>
