<Window x:Class="Poe2OverlayCompanion.PassiveTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Poe2OverlayCompanion.Controls"
        Title="PoE 2 Passive Tree Viewer"
        Width="980" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF000000" Foreground="#FFECE8E1" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF1B1917" BorderBrush="#FF342F2A" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TitleText" Text="Passive Tree" Foreground="#FFECE8E1" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+" Padding="10,4" Margin="0,0,4,0" Background="#FF25221F" Foreground="#FFECE8E1" BorderBrush="#FF342F2A" Click="ZoomIn_Click"/>
                    <Button Content="−" Padding="10,4" Margin="0,0,4,0" Background="#FF25221F" Foreground="#FFECE8E1" BorderBrush="#FF342F2A" Click="ZoomOut_Click"/>
                    <Button x:Name="BtnFit" Content="⌖ Центр" Padding="10,4" Background="#FFC89B3C" Foreground="#FF121110" FontWeight="SemiBold" BorderBrush="#FFC89B3C" Click="Fit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <controls:PassiveTreeView x:Name="FullTreeCanvas" Grid.Row="1"/>
    </Grid>
</Window>
