<Window x:Class="Poe2OverlayCompanion.PassiveTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Poe2OverlayCompanion.Controls"
        Title="PoE 2 Passive Tree Viewer"
        Width="980" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF000000" Foreground="#FFE6E8ED" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF212529" BorderBrush="#FF343A40" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TitleText" Text="Passive Tree" Foreground="#FFDEE2E6" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+" Padding="10,4" Margin="0,0,4,0" Background="#FF2B3035" Foreground="#FFDEE2E6" BorderBrush="#FF495057" Click="ZoomIn_Click"/>
                    <Button Content="−" Padding="10,4" Margin="0,0,4,0" Background="#FF2B3035" Foreground="#FFDEE2E6" BorderBrush="#FF495057" Click="ZoomOut_Click"/>
                    <Button Content="⌖ Центр" Padding="10,4" Background="#FF0D6EFD" Foreground="#FFFFFFFF" FontWeight="SemiBold" BorderBrush="#FF0D6EFD" Click="Fit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <controls:PassiveTreeView x:Name="FullTreeCanvas" Grid.Row="1"/>
    </Grid>
</Window>
