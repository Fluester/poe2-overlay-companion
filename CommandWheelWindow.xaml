<Window x:Class="Poe2OverlayCompanion.CommandWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="350"
        SizeToContent="Height"
        Background="#FF1B1917">

    <Border Background="#FF1B1917" BorderBrush="#FF342F2A" BorderThickness="1" Padding="11">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" Text="Quick Commands (F8)" Foreground="#FFC89B3C" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                <Button Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="24" Height="20"
                        Background="#FF2A1616" Foreground="#FFE05252" BorderBrush="#FF632A2A" FontSize="10"
                        Cursor="Hand" Focusable="False" Click="Close_Click"/>
            </DockPanel>

            <UniformGrid Columns="3" Rows="3">
                <Button x:Name="BtnHideout" Content="Hideout" Margin="2.5" Padding="6,8" Background="#FF25221F" Foreground="#FFECE8E1" BorderBrush="#FF342F2A" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Focusable="False" Click="RunHideout_Click"/>
                <Button x:Name="BtnKingsmarch" Content="Kingsmarch" Margin="2.5" Padding="6,8" Background="#FF25221F" Foreground="#FFECE8E1" BorderBrush="#FF342F2A" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Focusable="False" Click="RunKingsmarch_Click"/>
                <Button x:Name="BtnRemaining" Content="/remaining" Margin="2.5" Padding="6,8" Background="#FF152418" Foreground="#FF3FB950" BorderBrush="#FF2A5231" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Focusable="False" Click="RunRemaining_Click"/>

                <Button x:Name="BtnPassives" Content="/passives" Margin="2.5" Padding="6,8" Background="#FF2E2618" Foreground="#FFC89B3C" BorderBrush="#FF5C4822" FontSize="10.5" Cursor="Hand" Focusable="False" Click="RunPassives_Click"/>
                <Button x:Name="BtnDeaths" Content="/deaths" Margin="2.5" Padding="6,8" Background="#FF2A1616" Foreground="#FFE05252" BorderBrush="#FF632A2A" FontSize="10.5" Cursor="Hand" Focusable="False" Click="RunDeaths_Click"/>
                <Button x:Name="BtnLastThanks" Content="@Last Thx" Margin="2.5" Padding="6,8" Background="#FF22201D" Foreground="#FFB5AEA4" BorderBrush="#FF3D3832" FontSize="10.5" Cursor="Hand" Focusable="False" Click="RunLastThanks_Click"/>

                <Button x:Name="BtnLastWait" Content="@Last Wait" Margin="2.5" Padding="6,8" Background="#FF292112" Foreground="#FFD29922" BorderBrush="#FF5E4719" FontSize="10.5" Cursor="Hand" Focusable="False" Click="RunLastWait_Click"/>
                <Button x:Name="BtnCustom1" Content="Cmd 1" Margin="2.5" Padding="6,8" Background="#FF25221F" Foreground="#FF9C958B" BorderBrush="#FF342F2A" FontSize="10" Cursor="Hand" Focusable="False" Click="RunCustom1_Click"/>
                <Button x:Name="BtnCustom2" Content="Cmd 2" Margin="2.5" Padding="6,8" Background="#FF25221F" Foreground="#FF9C958B" BorderBrush="#FF342F2A" FontSize="10" Cursor="Hand" Focusable="False" Click="RunCustom2_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
