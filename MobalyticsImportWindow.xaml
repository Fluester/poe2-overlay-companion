<Window x:Class="Poe2OverlayCompanion.MobalyticsImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mobalytics Direct Build Import — PoE 2 Overlay Companion"
        Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF16191D" Foreground="#FFDEE2E6" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MobaBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF2B3035"/>
            <Setter Property="Foreground" Value="#FFDEE2E6"/>
            <Setter Property="BorderBrush" Value="#FF495057"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF343A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MobaBrassBtn" TargetType="Button" BasedOn="{StaticResource MobaBtn}">
            <Setter Property="Background" Value="#FF0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF0D6EFD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0B5ED7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Навігація + Кнопки прямого імпорту -->
        <Border Grid.Row="0" Background="#FF212529" BorderBrush="#FF343A40" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mobalytics" Foreground="#FF6EA8FE" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBox x:Name="UrlBox" Grid.Column="1" Background="#FF16191D" Foreground="#FFDEE2E6"
                         BorderBrush="#FF495057" BorderThickness="1" Padding="8,5" FontSize="11"
                         VerticalContentAlignment="Center" KeyDown="UrlBox_KeyDown"/>

                <Button x:Name="BtnNavigate" Grid.Column="2" Content="Відкрити" Style="{StaticResource MobaBtn}"
                        Margin="6,0,6,0" Click="Navigate_Click"/>

                <Button x:Name="BtnImportCurrent" Grid.Column="3" Content="Імпортувати поточний варіант"
                        Style="{StaticResource MobaBrassBtn}" Margin="0,0,6,0" Click="ImportCurrent_Click"/>

                <Button x:Name="BtnImportAll" Grid.Column="4" Content="Імпортувати ВСІ варіанти (етапи)"
                        Style="{StaticResource MobaBtn}" Foreground="#FF75B798" BorderBrush="#FF0F5132"
                        Margin="0,0,6,0" Click="ImportAllVariants_Click"/>

                <Button x:Name="BtnClipFallback" Grid.Column="5" Content="З буфера (Ctrl+A Ctrl+C)"
                        Style="{StaticResource MobaBtn}" Foreground="#FF6EA8FE" Click="ImportFromClipboard_Click"/>
            </Grid>
        </Border>

        <!-- Статус-рядок -->
        <Border Grid.Row="1" Background="#FF1B1F23" BorderBrush="#FF343A40" BorderThickness="0,0,0,1" Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Відкрий будь-який білд на mobalytics.gg/poe-2/builds (за потреби пройди перевірку браузера) і натисни «Імпортувати»."
                       Foreground="#FFADB5BD" FontSize="10.5" TextWrapping="Wrap"/>
        </Border>

        <!-- Інтерактивний WebView2 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="2" DefaultBackgroundColor="#FF16191D"/>
    </Grid>
</Window>
