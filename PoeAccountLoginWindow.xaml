<Window x:Class="Poe2OverlayCompanion.PoeAccountLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PoE 2 Account Connect — pathofexile.com"
        Width="980" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E1117" Foreground="#FFE6E8ED" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF141820" BorderBrush="#FF232834" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <TextBlock Text="POE 2 ACCOUNT SYNC" Foreground="#FFD4B06A" FontWeight="Bold" FontSize="11.5"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox x:Name="CharCombo" Width="260" Height="28" Background="#FF0B0D11" Foreground="#FFE6E8ED"
                          BorderBrush="#FF2D3443" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                <Button x:Name="BtnFetchChars" Content="Завантажити персонажів" Padding="10,5" Margin="0,0,6,0"
                        Background="#FF1A1F29" Foreground="#FF69ACEC" BorderBrush="#FF344D70" Cursor="Hand" Click="FetchCharacters_Click"/>

                <Button x:Name="BtnSyncSelected" Content="Синхронізувати (Рівень + Шмот + Пасивки)" Padding="10,5" Margin="0,0,6,0"
                        Background="#FFC49E57" Foreground="#FF111318" FontWeight="SemiBold" BorderBrush="#FFD8B872" Cursor="Hand" Click="SyncSelected_Click"/>

                <Button x:Name="BtnScanStash" Content="Оцінити скриню (Stash)" Padding="10,5" Margin="0,0,8,0"
                        Background="#FF163225" Foreground="#FF4ECF8F" FontWeight="SemiBold" BorderBrush="#FF2A5A44" Cursor="Hand" Click="ScanStash_Click"/>

                <CheckBox x:Name="ChkImportAsBuild" Content="+ як окремий білд" IsChecked="False"
                          Foreground="#FFE6E8ED" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FF11151C" BorderBrush="#FF232834" BorderThickness="0,0,0,1" Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Увійди в свій PoE акаунт на pathofexile.com (Steam / Epic / GGG), потім натисни «Завантажити персонажів» -> «Синхронізувати»."
                       Foreground="#FF8B93A5" FontSize="10.5" TextWrapping="Wrap"/>
        </Border>

        <wv2:WebView2 x:Name="WebView" Grid.Row="2" DefaultBackgroundColor="#FF0E1117"/>
    </Grid>
</Window>
