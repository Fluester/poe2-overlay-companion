                                <StackPanel>
                                    <TextBlock x:Name="LblKpiEncounters" Text="Енкаунтери / Смерті" Foreground="#FF848B98" FontSize="10"/>
                                    <TextBlock x:Name="ValKpiEncounters" Text="0 / 0" Foreground="#FF69ACEC" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10">
