                                <StackPanel>
                                    <TextBlock x:Name="LblKpiZone" Text="Поточна локація" Foreground="#FF848B98" FontSize="10"/>
                                    <TextBlock x:Name="ValKpiZone" Text="—" Foreground="#FFC8A462" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
