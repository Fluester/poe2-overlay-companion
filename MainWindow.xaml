                                                      Style="{StaticResource DarkCheck}" Checked="BuffSettingsChanged" Unchecked="BuffSettingsChanged"/>
                                            <TextBox x:Name="BuffKeyBox" Grid.Column="2" Style="{StaticResource DarkBox}" FontSize="10" Padding="5,3" Text="X" ToolTip="Key"/>
                                            <TextBox x:Name="BuffLabelBox" Grid.Column="4" Style="{StaticResource DarkBox}" FontSize="10" Padding="5,3" Text="Buff" ToolTip="Label"/>
                                            <TextBox x:Name="BuffSecBox" Grid.Column="6" Style="{StaticResource DarkBox}" FontSize="10" Padding="5,3" Text="12" ToolTip="Seconds"/>
                                            <Button x:Name="BtnSaveBuff" Grid.Column="8" Content="OK" Style="{StaticResource FlatButton}"
                                                    FontSize="10" Padding="8,3" Click="SaveBuffTimer_Click"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblCustomCmds" Text="F8 команди:" Foreground="#FF848B98" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomCmd1Box" Grid.Column="2" Style="{StaticResource DarkBox}" FontSize="10" Padding="5,3" Text="/hideout"/>
                                            <TextBox x:Name="CustomCmd2Box" Grid.Column="4" Style="{StaticResource DarkBox}" FontSize="10" Padding="5,3" Text="/remaining"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Куточок для зміни розміру вікна мишею прямо в грі -->
            <Thumb x:Name="ResizeGrip" Grid.Row="1" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta" Opacity="0.35">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 11,2 L 2,11 M 11,6 L 6,11" Stroke="#FFC8A462" StrokeThickness="1.3"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
