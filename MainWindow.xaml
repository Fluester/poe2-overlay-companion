                                <StackPanel>
                                    <TextBlock x:Name="FarmStatsBodyText" Foreground="#FF848B98" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                    <Border Background="#FF0F1115" BorderBrush="#FF2A3140" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,7,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="LblStashHeader" Text="Скриня (Net-Worth)" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="10.5"/>
