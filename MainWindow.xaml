                                            </DockPanel>
                                            <TextBlock x:Name="StashBreakdownText" Text="Натисни «Оцінити скриню (Stash)» (потрібен вхід у PoE 2 акаунт)." Foreground="#FF848B98" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
