                                              Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
                                    <Button x:Name="BtnInterval48" Content="2 дні" Style="{StaticResource FlatButton}"
                                            FontSize="10" Padding="8,3" Margin="0,0,4,0" Click="SetInterval48_Click"/>
                                    <Button x:Name="BtnInterval60" Content="2.5 дні" Style="{StaticResource FlatButton}"
                                            FontSize="10" Padding="8,3" Margin="0,0,4,0" Click="SetInterval60_Click"/>
                                    <Button x:Name="BtnInterval72" Content="3 дні" Style="{StaticResource FlatButton}"
                                            FontSize="10" Padding="8,3" Click="SetInterval72_Click"/>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnCheckUpdatesNow" Grid.Column="0" Content="Перевірити всі білди"
                                            Style="{StaticResource BrassButton}" FontSize="10" Click="CheckUpdatesNow_Click"/>
                                    <Button x:Name="BtnOpenGuideUpd" Grid.Column="2" Content="Відкрити гайд"
                                            Style="{StaticResource FlatButton}" FontSize="10" Foreground="#FF69ACEC" Click="OpenGuideUrl_Click"/>
                                    <Button x:Name="BtnDiffClipboard" Grid.Column="4" Content="Diff з буфера (Ctrl+C)"
                                            Style="{StaticResource FlatButton}" FontSize="10" Foreground="#FF4ECF8F" Click="DiffClipboardGuide_Click"/>
                                    <Button x:Name="BtnAiDiff" Grid.Column="6" Content="AI Diff (Ctrl+C)"
                                            Style="{StaticResource FlatButton}" FontSize="10" Click="CompareGuideWithAi_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdateStatusText" Grid.Row="1"
                                   Text="Моніторинг змін навиків, спорядження, пасивок, PoB2 і URL гайдів."
                                   Foreground="#FF848B98" FontSize="10.5" Margin="2,0,0,6" TextWrapping="Wrap"/>

                        <Border Grid.Row="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="UpdateHistoryPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 7. AI-РАДНИК -->
                    <Grid x:Name="PageAi" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,7">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="AiStatusText" Text="AI: ready"
                                               Foreground="#FF4ECF8F" FontWeight="SemiBold" FontSize="11"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnToggleApiDrawer" Content="Налаштування API" Style="{StaticResource FlatButton}"
                                                FontSize="9.5" Padding="8,2" Margin="0,0,5,0" Click="GoToSettingsTab_Click"/>
                                        <Button x:Name="AiTypeBtn" Content="Режим вводу" Style="{StaticResource FlatButton}"
                                                FontSize="9.5" Padding="8,2" Click="ToggleTyping_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AiQuestionBox" Grid.Column="0" Style="{StaticResource DarkBox}" Height="32" Text=""/>
                                    <Button x:Name="BtnAiAsk" Grid.Column="2" Content="Запитати" Style="{StaticResource FlatButton}"
                                            Foreground="#FF69ACEC" FontSize="10.5" FontWeight="SemiBold" Click="AiAskText_Click"/>
                                    <Button x:Name="BtnAiScreen" Grid.Column="4" Content="Скрін + AI (F11)" Style="{StaticResource BrassButton}"
                                            FontSize="10.5" Click="AiScanNow_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AiMetaText" Grid.Row="1" Text="Натисни F11 у грі, щоб AI проаналізував екран."
                                   Foreground="#FF848B98" FontSize="10.5" Margin="2,0,0,5"/>

                        <Border Grid.Row="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="11">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="AiResponseText" Foreground="#FFE4DFD5" FontSize="11.5"
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 8. ІМПОРТ БІЛДІВ (ПАКЕТНИЙ) ТА ПРОФІЛІ -->
                    <Grid x:Name="PageBuilds" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Профілі білдів користувача -->
                        <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,7">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="LblProfilesTitle" Text="МОЇ ПРОФІЛІ БІЛДІВ" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="10.5"/>
                                    <Button x:Name="BtnDeleteProfile" Content="Видалити обраний" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                                            Foreground="#FFEA6161" FontSize="9.5" Padding="8,2" Click="DeleteProfile_Click"/>
                                </DockPanel>
                                <WrapPanel x:Name="ProfilesPillsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Пакетний імпорт (Mobalytics, .build, PoB2, pobb.in, URL, Drag&Drop) -->
                        <Border Grid.Row="1" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="LblBatchImportTitle" Text="ПАКЕТНИЙ ІМПОРТ (Drag &amp; Drop .build / Mobalytics / PoB2 / URL)"
                                               Foreground="#FF69ACEC" FontWeight="SemiBold" FontSize="10"/>
                                    <Button x:Name="PobTypeToggleBtn" Content="Режим вводу" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                                            FontSize="9.5" Padding="8,2" Click="ToggleTyping_Click"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblProfileName" Text="Назва:" Foreground="#FF848B98" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="NewProfileNameBox" Grid.Column="1" Style="{StaticResource DarkBox}" FontSize="10.5" Text=""/>
                                </Grid>

                                <CheckBox x:Name="ChkMergeBatchStages" Content="Об'єднати обрані .build файли як етапи ОДНОГО білду (за рівнями)"
                                          IsChecked="True" Style="{StaticResource DarkCheck}" Margin="0,0,0,6"/>

                                <WrapPanel Margin="0,0,0,7">
                                    <Button x:Name="BtnImportMobalytics" Content="+ Mobalytics (Браузер)" Style="{StaticResource BrassButton}"
                                            FontSize="10" Margin="0,0,5,4" Click="OpenMobalyticsImport_Click"/>
                                    <Button x:Name="BtnBatchFiles" Content="+ Обрати .build (кілька)" Style="{StaticResource FlatButton}"
                                            FontSize="10" Margin="0,0,5,4" Click="BatchImportFiles_Click"/>
                                    <Button x:Name="BtnBatchFolder" Content="+ Папка з .build" Style="{StaticResource FlatButton}"
                                            Foreground="#FF4ECF8F" FontSize="10" Margin="0,0,5,4" Click="BatchImportFolder_Click"/>
                                    <Button x:Name="BtnPastePob" Content="Вставити з буфера" Style="{StaticResource FlatButton}"
                                            Foreground="#FF69ACEC" FontSize="10" Margin="0,0,5,4" Click="PastePob_Click"/>
                                    <Button x:Name="BtnImportMultiText" Content="+ Імпорт списку (PoB2 / URL)" Style="{StaticResource FlatButton}"
                                            FontSize="10" Margin="0,0,0,4" Click="BatchImportLines_Click"/>
                                </WrapPanel>

                                <TextBox x:Name="PobInputBox" Style="{StaticResource DarkBox}" Height="82"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="ImportStatusText" Text="" Foreground="#FF848B98" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 9. НАЛАШТУВАННЯ (Акаунт, Ліга, Розмір у грі, AI API, Таймер бафу, Client.txt) -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Картка 1: Підключення акаунта PoE 2 + Рівень + Ліга -->
                                <Border Background="#FF13151B" BorderBrush="#FF22252E" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,7">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="LblSettingsAccountTitle" Text="АКАУНТ POE 2, ПЕРСОНАЖ ТА ЛІГА" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="10"/>
                                            <Button x:Name="SettingsTypeBtn" Content="Режим вводу" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,2" Click="ToggleTyping_Click"/>
                                        </DockPanel>

                                        <WrapPanel Margin="0,0,0,7">
                                            <Button x:Name="BtnConnectPoeAccount" Content="Підключити PoE 2 акаунт (Офіційний)" Style="{StaticResource BrassButton}"
                                                    FontSize="10" Padding="9,4" Margin="0,0,6,4" Click="ConnectPoeAccount_Click"/>
                                            <TextBlock x:Name="LblPoeAccountStatus" Text="Не підключено" Foreground="#FF848B98" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,4" TextWrapping="Wrap"/>
                                        </WrapPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblSettingsLeague" Text="Ліга:" Foreground="#FF848B98" FontSize="10.5" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="LeagueCombo" Grid.Column="2" IsEditable="True" Background="#FF0F1218" Foreground="#FFE4DFD5"
                                                      BorderBrush="#FF22252E" FontSize="10.5" Height="26" SelectionChanged="LeagueCombo_Changed"/>
                                            <Button x:Name="BtnRefreshLeagues" Grid.Column="4" Content="↻ Ліги" Style="{StaticResource FlatButton}"
                                                    FontSize="10" Padding="8,3" Click="RefreshLeagues_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 2: Розмір оверлея в грі, поведінка і Client.txt -->
                                <Border Background="#FF13151B" BorderBrush="#FF22252E" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,7">
                                    <StackPanel>
                                        <TextBlock x:Name="LblAppSettingsTitle" Text="РОЗМІР ОВЕРЛЕЯ, ЛОГ ТА СИСТЕМНІ" Foreground="#FF848B98" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                        <WrapPanel Margin="0,0,0,7">
                                            <TextBlock x:Name="LblOverlaySize" Text="Розмір у грі:" Foreground="#FF848B98" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <Button x:Name="BtnSizeS" Content="S (460×360)" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,2" Margin="0,0,4,2" Click="SetSizeS_Click"/>
                                            <Button x:Name="BtnSizeM" Content="M (560×430)" Style="{StaticResource BrassButton}" FontSize="9.5" Padding="7,2" Margin="0,0,4,2" Click="SetSizeM_Click"/>
                                            <Button x:Name="BtnSizeL" Content="L (740×560)" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,2" Margin="0,0,8,2" Click="SetSizeL_Click"/>
                                            <TextBlock x:Name="LblPortableStatus" Text="" Foreground="#FF4ECF8F" FontSize="9.5" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox x:Name="ChkHideNoGame" Content="Ховати без PoE 2" IsChecked="False"
                                                      Style="{StaticResource DarkCheck}" Margin="0,0,12,4" Checked="AiSettingsChanged" Unchecked="AiSettingsChanged"/>
                                            <CheckBox x:Name="ChkAutostart" Content="Запуск з Windows" IsChecked="False"
                                                      Style="{StaticResource DarkCheck}" Margin="0,0,12,4" Checked="AutostartChanged" Unchecked="AutostartChanged"/>
                                            <CheckBox x:Name="ChkFocusOnCtrlC" Content="Відкривати вкладку при Ctrl+C" IsChecked="False"
                                                      Style="{StaticResource DarkCheck}" Margin="0,0,12,4" Checked="AiSettingsChanged" Unchecked="AiSettingsChanged"/>
                                            <CheckBox x:Name="ChkTradeHelper" Content="Trade Helper (шепіт)" IsChecked="True"
                                                      Style="{StaticResource DarkCheck}" Margin="0,0,12,4" Checked="AiSettingsChanged" Unchecked="AiSettingsChanged"/>
                                            <Button x:Name="LogBtn" Content="Обрати Client.txt" Style="{StaticResource FlatButton}"
                                                    FontSize="9.5" Padding="8,2" Margin="0,0,5,4" Click="PickClientTxt_Click"/>
                                            <Button x:Name="InstallFilterBtn" Content="Встановити .filter" Style="{StaticResource FlatButton}"
                                                    FontSize="9.5" Padding="8,2" Margin="0,0,0,4" Click="InstallFilter_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 3: AI API Ключ і модель -->
                                <Border Background="#FF13151B" BorderBrush="#FF22252E" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,7">
                                    <StackPanel x:Name="ApiConfigDrawer">
                                        <TextBlock x:Name="LblSettingsAiTitle" Text="AI-РАДНИК ТА ГЕНЕРАТОР ФІЛЬТРІВ (API)" Foreground="#FF69ACEC" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="BtnProvGemini" Content="Google Gemini" Style="{StaticResource FlatButton}"
                                                    FontSize="9.5" Padding="8,3" Margin="0,0,5,3" Click="SelectProviderGemini_Click"/>
                                            <Button x:Name="BtnProvOpenAi" Content="OpenAI / OpenRouter / Ollama" Style="{StaticResource FlatButton}"
                                                    FontSize="9.5" Padding="8,3" Margin="0,0,10,3" Click="SelectProviderOpenAi_Click"/>
                                            <CheckBox x:Name="ChkAutoAi30" Content="Авто-скан 30хв" IsChecked="False"
                                                      Style="{StaticResource DarkCheck}" Margin="0,0,10,3" Checked="AiSettingsChanged" Unchecked="AiSettingsChanged"/>
                                            <CheckBox x:Name="ChkAiOnlySafeZone" Content="Лише місто/Hideout" IsChecked="True"
