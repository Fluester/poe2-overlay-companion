<Window x:Class="Poe2OverlayCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Poe2OverlayCompanion.Controls"
        Title="PoE 2 Overlay Companion"
        Width="560"
        Height="430"
        MinWidth="440"
        MinHeight="340"
        Left="18"
        Top="45"
        WindowStyle="None"
        Background="#FF0A0B0D"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="3"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF2B3242" CornerRadius="2.5" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Background" Value="#FF13151B"/>
            <Setter Property="Foreground" Value="#FFE4DFD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF22252E"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D222E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6E5932"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BrassButton" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF231D12"/>
            <Setter Property="BorderBrush" Value="#FF6E5932"/>
            <Setter Property="Foreground" Value="#FFC8A462"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF848B98"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,1.5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF171B24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="DarkBox">
            <Setter Property="Background" Value="#FF0F1218"/>
            <Setter Property="Foreground" Value="#FFE4DFD5"/>
            <Setter Property="CaretBrush" Value="#FFC8A462"/>
            <Setter Property="BorderBrush" Value="#FF22252E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="DarkCheck">
            <Setter Property="Foreground" Value="#FFC5CBD8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="Foreground" Value="#FF848B98"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#FF0A0B0D"
            BorderBrush="#FF2A2F3D"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Border Grid.Row="0"
                    Background="#FF0F1115"
                    BorderBrush="#FF202531"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="9,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Векторна емблема ромба PoE 2 -->
                        <Path Data="M 6,0 L 12,6 L 6,12 L 0,6 Z" Fill="#FFC8A25A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Border Background="#FF1B1710" BorderBrush="#FF6E5932" BorderThickness="1"
                                CornerRadius="3" Padding="6,2" Margin="0,0,5,0" MaxWidth="135">
                            <TextBlock x:Name="HeaderBuildBadge" Text="PoE 2" Foreground="#FFC8A462"
                                       FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <!-- Швидкий перемикач рівня прямо в шапці -->
                        <Border Background="#FF13151B" BorderBrush="#FF22252E" BorderThickness="1" CornerRadius="3" Padding="2,1" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="−" Style="{StaticResource FlatButton}" BorderThickness="0" Padding="4,0" FontSize="10" Click="LevelDec_Click"/>
                                <TextBlock x:Name="StatusText" Text="Lvl 1" Foreground="#FFE4DFD5" FontWeight="SemiBold" FontSize="10" Margin="3,0" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource FlatButton}" BorderThickness="0" Padding="4,0" FontSize="10" Click="LevelInc_Click"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="HeaderLeagueBtn" Content="Forbidden Rites" Style="{StaticResource FlatButton}"
                                Foreground="#FF4ECF8F" BorderBrush="#FF2A5A44" FontSize="9.5" Padding="5,2" Margin="0,0,5,0" Click="GoToSettingsTab_Click"/>
                        <TextBlock x:Name="BuffTimerText" Text="" Foreground="#FF4ECF8F"
                                   FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF0A0B0D" BorderBrush="#FF202531" BorderThickness="1" CornerRadius="2" Padding="1" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LangBtnUk" Content="UA" Style="{StaticResource FlatButton}"
                                        BorderThickness="0" Padding="4,2" FontSize="9" FontWeight="SemiBold" Click="LangUk_Click"/>
                                <Button x:Name="LangBtnEn" Content="EN" Style="{StaticResource FlatButton}"
                                        BorderThickness="0" Padding="4,2" FontSize="9" FontWeight="SemiBold" Click="LangEn_Click"/>
                                <Button x:Name="LangBtnRu" Content="RU" Style="{StaticResource FlatButton}"
                                        BorderThickness="0" Padding="4,2" FontSize="9" FontWeight="SemiBold" Click="LangRu_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnMiniHud" Content="HUD" ToolTip="Mini-HUD" Style="{StaticResource FlatButton}"
                                Foreground="#FF69ACEC" FontSize="9.5" Margin="0,0,3,0" Padding="6,2" Click="SwitchToMiniHud_Click"/>
                        <Button x:Name="BtnCommandWheel" Content="F8" ToolTip="Quick Commands (F8)" Style="{StaticResource FlatButton}"
                                Foreground="#FFC8A462" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,3,0" Padding="6,2" Click="OpenCommandWheel_Click"/>
                        <Button x:Name="AiQuickBtn" Content="F11" ToolTip="Screen + AI" Style="{StaticResource FlatButton}"
                                Background="#FF172130" BorderBrush="#FF344D70" Foreground="#FF69ACEC"
                                FontSize="9.5" FontWeight="SemiBold" Margin="0,0,3,0" Padding="6,2" Click="AiScanNow_Click"/>
                        <Button x:Name="AlphaBtn" ToolTip="Opacity" Style="{StaticResource FlatButton}"
                                Margin="0,0,3,0" Padding="6,3" Click="CycleAlpha_Click">
                            <Path Data="M 5,0 A 5,5 0 1 1 4.99,0 Z M 5,1 L 5,9 A 4,4 0 0 1 5,1 Z" Fill="#FF848B98" Stretch="Uniform" Width="9" Height="9"/>
                        </Button>
                        <Button x:Name="LockBtn" Content="F10" Style="{StaticResource FlatButton}"
                                Background="#FF13261E" BorderBrush="#FF2A5A44" Foreground="#FF4ECF8F"
                                FontSize="9.5" FontWeight="SemiBold" Margin="0,0,3,0" Padding="6,2" Click="ToggleClickThrough_Click"/>
                        <Button x:Name="CollapseBtn" Content="F9" Style="{StaticResource FlatButton}"
                                Foreground="#FFE4DFD5" FontSize="9.5" FontWeight="SemiBold"
                                Margin="0,0,3,0" Padding="6,2" Click="ToggleCollapse_Click"/>
                        <Button Content="×" Style="{StaticResource FlatButton}"
                                Background="#FF241416" BorderBrush="#FF52282D" Foreground="#FFEA6161"
                                FontSize="11.5" FontWeight="Bold" Padding="6,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- РОБОЧА ОБЛАСТЬ -->
            <Grid x:Name="BodyGrid" Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- БІЧНА НАВІГАЦІЯ (векторні іконки, без спаму емодзі) -->
                <Border Grid.Column="0" Background="#FF0F1115" BorderBrush="#FF202531"
                        BorderThickness="1" CornerRadius="2" Padding="6">
                    <StackPanel x:Name="NavStack">
                        <Button x:Name="NavBtnOverview" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1,1 H 6 V 6 H 1 Z M 8,1 H 13 V 6 H 8 Z M 1,8 H 6 V 13 H 1 Z M 8,8 H 13 V 13 H 8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavOverview" Text="Огляд білду"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnPassives" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 7,1 L 12,5 L 10,12 L 4,12 L 2,5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavPassives" Text="Дерево пасивок"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnItems" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 7,1 L 13,3.5 V 7.5 C 13,10.5 10,12.5 7,13.5 C 4,12.5 1,10.5 1,7.5 V 3.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavItems" Text="Предмети"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnPlanner" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,1 H 10 L 13,4 V 13 H 2 Z M 4,6 H 11 M 4,9 H 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavPlanner" Text="Планувальник"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnFarm" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1,12 V 7 M 5,12 V 4 M 9,12 V 6 M 13,12 V 2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavFarm" Text="Трекер сесії"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnUpdates" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 11,4 A 5,5 0 1 0 12,8 M 11,1 V 4 H 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavUpdates" Text="Оновлення"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnAi" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 7,1 L 8.5,5.5 L 13,7 L 8.5,8.5 L 7,13 L 5.5,8.5 L 1,7 L 5.5,5.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtNavAi" Text="AI-радник"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnBuilds" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 7,2 V 12 M 2,7 H 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtNavBuilds" Text="Імпорт і Профілі"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBtnSettings" Style="{StaticResource NavButton}" Click="NavClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 7,4 A 3,3 0 1 1 6.99,4 Z M 7,0.5 V 2.2 M 7,11.8 V 13.5 M 0.5,7 H 2.2 M 11.8,7 H 13.5 M 2.4,2.4 L 3.6,3.6 M 10.4,10.4 L 11.6,11.6 M 11.6,2.4 L 10.4,3.6 M 3.6,10.4 L 2.4,11.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtNavSettings" Text="Налаштування"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- КОНТЕНТ СТОРІНОК -->
                <Grid Grid.Column="2">

                    <!-- 1. ОГЛЯД БІЛДУ + ГЕМОПЕДІЯ + ЕКІП (ДЕ ВЗЯТИ) -->
                    <Grid x:Name="PageOverview" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок активного білду + перемикач етапів -->
                        <Border x:Name="OverviewHeaderCard" Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="11,9" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="OverviewBuildTitle" Text="Білди не додано" Foreground="#FFC8A462"
                                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="OverviewBuildMeta" Text="" Foreground="#FF848B98" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="OverviewStageNav" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button Content="‹" Style="{StaticResource FlatButton}" Padding="9,3" Click="OverviewPrevStage_Click"/>
                                    <TextBlock x:Name="OverviewStageLabel" Text="" Foreground="#FFE4DFD5" FontSize="11" FontWeight="SemiBold"
                                               Margin="8,0" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                    <Button Content="›" Style="{StaticResource FlatButton}" Padding="9,3" Click="OverviewNextStage_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Перемикач підвкладок Огляду -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,7">
                            <Button x:Name="BtnSubOverviewMain" Content="Огляд білду" Style="{StaticResource BrassButton}"
                                    FontSize="10.5" Padding="10,4" Margin="0,0,6,0" Click="ShowOverviewMainSubtab_Click"/>
                            <Button x:Name="BtnSubOverviewGems" Content="Камені та рівні" Style="{StaticResource FlatButton}"
                                    FontSize="10.5" Padding="10,4" Margin="0,0,6,0" Click="ShowOverviewGemsSubtab_Click"/>
                            <Button x:Name="BtnSubOverviewGear" Content="Шмотки: де взяти" Style="{StaticResource FlatButton}"
                                    FontSize="10.5" Padding="10,4" Click="ShowOverviewGearSubtab_Click"/>
                        </StackPanel>

                        <!-- Банер зони -->
                        <Border x:Name="ZoneTipBanner" Grid.Row="2" Background="#FF13261E" BorderBrush="#FF2A5A44"
                                BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="0,0,0,7" Visibility="Collapsed">
                            <TextBlock x:Name="ZoneTipText" Foreground="#FF4ECF8F" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Підвкладка 1а: Стан без білдів + Основні картки білду -->
                        <Grid x:Name="OverviewMainSubPanel" Grid.Row="3">
                            <Border x:Name="OverviewEmptyCard" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="18" Visibility="Visible">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                    <TextBlock x:Name="OverviewEmptyTitle" Text="Поки що немає активного білду"
                                               Foreground="#FFC8A462" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewEmptyBody" Text="" Foreground="#FF848B98" FontSize="11.5"
                                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,14"/>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button x:Name="BtnOnboardMobalytics" Content="+ Mobalytics (Браузер)" Style="{StaticResource BrassButton}"
                                                Margin="0,0,6,6" Click="OpenMobalyticsImport_Click"/>
                                        <Button x:Name="BtnOnboardImportFiles" Content="+ Пакетний імпорт .build" Style="{StaticResource FlatButton}"
                                                Margin="0,0,6,6" Click="BatchImportFiles_Click"/>
                                        <Button x:Name="BtnOnboardGoImport" Content="PoB2 / pobb.in / URL" Style="{StaticResource FlatButton}"
                                                Margin="0,0,6,6" Click="GoToBuildsTab_Click"/>
                                        <Button x:Name="BtnOnboardLoadPlanner" Content="З папки BuildPlanner" Style="{StaticResource FlatButton}"
                                                Margin="0,0,0,6" Click="ImportFromGamePlannerFolder_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="OverviewContentWrap" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Детальний інспектор натиснутого каменя / предмета -->
                                <Border x:Name="OverviewInspectorCard" Grid.Row="0" Background="#FF171E2B" BorderBrush="#FFC49E57"
                                        BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,7" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="InspectorTitleText" Text="" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="InspectorMetaText" Text="" Foreground="#FF4ECF8F" FontSize="10.5" Margin="0,2,0,3" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="InspectorBodyText" Text="" Foreground="#FFE4DFD5" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <Button x:Name="BtnInspectorClose" Content="✕" Style="{StaticResource FlatButton}" Padding="7,2" FontSize="10" Margin="0,0,0,4" Click="CloseInspector_Click"/>
                                            <Button x:Name="BtnInspectorAskAi" Content="AI" Style="{StaticResource FlatButton}" Foreground="#FF69ACEC" Padding="7,2" FontSize="9.5" Click="AskAiAboutInspector_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="OverviewContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OverviewCardsPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Підвкладка 1б: Камені навичок, підтримки, рівні та де отримати -->
                        <Grid x:Name="OverviewGemsPanel" Grid.Row="3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="8,7" Margin="0,0,0,7">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GemSearchBox" Grid.Column="0" Style="{StaticResource DarkBox}" FontSize="10.5"
                                                 Padding="7,4" TextChanged="GemFilterChanged"/>
                                        <Button x:Name="GemsTypeBtn" Grid.Column="2" Content="Режим вводу" Style="{StaticResource FlatButton}"
                                                FontSize="9.5" Padding="8,3" Click="ToggleTyping_Click"/>
                                    </Grid>
                                    <WrapPanel>
                                        <Button x:Name="BtnGemFilterBuild" Content="У білді" Style="{StaticResource BrassButton}" FontSize="9.5" Padding="8,3" Margin="0,0,4,0" Click="SetGemFilterBuild_Click"/>
                                        <Button x:Name="BtnGemFilterAll" Content="Каталог PoE 2" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="8,3" Margin="0,0,4,0" Click="SetGemFilterAll_Click"/>
                                        <Button x:Name="BtnGemFilterActive" Content="Active Skills" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="8,3" Margin="0,0,4,0" Click="SetGemFilterActive_Click"/>
                                        <Button x:Name="BtnGemFilterSupport" Content="Support (T1/T2/T3)" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="8,3" Margin="0,0,4,0" Click="SetGemFilterSupport_Click"/>
                                        <Button x:Name="BtnGemFilterSpirit" Content="Spirit / Heralds" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="8,3" Click="SetGemFilterSpirit_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="GemsCatalogPanel"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Підвкладка 1в: Спорядження, описи, де вибити/скрафтити та перевірка -->
                        <Grid x:Name="OverviewGearPanel" Grid.Row="3" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="GearObtainPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 2. ДЕРЕВО ПАСИВОК (ІНТЕРАКТИВНЕ ЯК У MOBALYTICS) -->
                    <Grid x:Name="PagePassives" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель керування деревом -->
                        <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="7,5" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblTreeStage" Text="Етап:" Foreground="#FF848B98" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="‹" Style="{StaticResource FlatButton}" Padding="6,2" Click="TreePrevStage_Click"/>
                                    <TextBlock x:Name="TreeStageTitle" Text="—" Foreground="#FFC8A462" FontSize="10.5" FontWeight="SemiBold"
                                               Margin="5,0" VerticalAlignment="Center" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                                    <Button Content="›" Style="{StaticResource FlatButton}" Padding="6,2" Click="TreeNextStage_Click"/>
                                    <CheckBox x:Name="ChkComparePrevStage" Content="Diff" IsChecked="True" Margin="7,0,0,0"
                                              Style="{StaticResource DarkCheck}" FontSize="10" Checked="TreeOptionChanged" Unchecked="TreeOptionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0">
                                    <Button x:Name="BtnSetAll" Content="All" Style="{StaticResource BrassButton}" FontSize="9.5" Padding="6,2" Margin="0,0,2,0" Click="TreeSetAll_Click"/>
                                    <Button x:Name="BtnSet1" Content="S1" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="6,2" Margin="0,0,2,0" Click="TreeSet1_Click"/>
                                    <Button x:Name="BtnSet2" Content="S2" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="6,2" Click="TreeSet2_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnToggleTreeList" Content="Список" Style="{StaticResource FlatButton}"
                                            FontSize="9.5" Padding="7,2" Margin="0,0,3,0" Click="ToggleTreeListDrawer_Click"/>
                                    <Button x:Name="BtnTreeFit" Content="⌖" ToolTip="Center" Style="{StaticResource FlatButton}"
                                            FontSize="10" Padding="6,2" Margin="0,0,3,0" Click="TreeFit_Click"/>
                                    <Button x:Name="BtnPopoutTree" Content="⛶" ToolTip="Popout Large Passive Tree" Style="{StaticResource BrassButton}"
                                            FontSize="10" Padding="6,2" Margin="0,0,3,0" Click="PopoutTreeWindow_Click"/>
                                    <Button x:Name="BtnTreeAiExplain" Content="AI" Style="{StaticResource FlatButton}"
                                            Background="#FF172130" BorderBrush="#FF344D70" Foreground="#FF69ACEC"
                                            FontSize="9.5" Padding="7,2" Click="TreeExplainAi_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Слайдер покрокового проходження пасивок -->
                        <Border Grid.Row="1" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="7,4" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblTreeSteps" Text="Крок:" Foreground="#FF848B98" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="-" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10.5" Click="TreeStepDec_Click"/>
                                    <TextBlock x:Name="TreeStepLabel" Text="0 / 0" Foreground="#FFE4DFD5" FontSize="10" FontWeight="SemiBold"
                                               Margin="5,0" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10.5" Click="TreeStepInc_Click"/>
                                </StackPanel>
                                <Slider x:Name="TreeStepSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="8,0"
                                        Focusable="False" ValueChanged="TreeStepSlider_Changed"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#FF4ECF8F" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="LblLegendAdd" Text="+" Foreground="#FF4ECF8F" FontSize="9.5" Margin="0,0,6,0"/>
                                    <Ellipse Width="6" Height="6" Fill="#FFC8A462" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="LblLegendKeep" Text="=" Foreground="#FFC8A462" FontSize="9.5" Margin="0,0,6,0"/>
                                    <Ellipse Width="6" Height="6" Fill="#FFEA6161" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="LblLegendRespec" Text="-" Foreground="#FFEA6161" FontSize="9.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Спліт: 2D Канвас на 100% ширини + висувна панель списку -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="TreeListGap" Width="0"/>
                                <ColumnDefinition x:Name="TreeListCol" Width="0"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FF0F1218" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                <Grid>
                                    <controls:PassiveTreeView x:Name="TreeCanvas"/>
                                    <Border Background="#CC11151E" BorderBrush="#FF2A3140" BorderThickness="1" CornerRadius="2"
                                            Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                                        <TextBlock x:Name="LblTreeCanvasHint" Text="ЛКМ = рух · Колесо = зум · ПКМ = центр · Клік по списку → фокус"
                                                   Foreground="#FF848B98" FontSize="9.5"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                        <Button Content="+" Style="{StaticResource FlatButton}" Padding="8,2" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" Click="TreeZoomIn_Click"/>
                                        <Button Content="−" Style="{StaticResource FlatButton}" Padding="8,2" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" Click="TreeZoomOut_Click"/>
                                        <Button Content="⌖" Style="{StaticResource BrassButton}" Padding="8,2" FontSize="11" Click="TreeFit_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkOnlyKeyPassives" Content="Лише Keystones / Notables" IsChecked="True"
                                                      Style="{StaticResource DarkCheck}" Checked="TreeOptionChanged" Unchecked="TreeOptionChanged"/>
                                            <Button x:Name="TreeTypeBtn" Content="Режим вводу" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    Style="{StaticResource FlatButton}" FontSize="9.5" Padding="6,2" Click="ToggleTyping_Click"/>
                                        </DockPanel>
                                        <TextBox x:Name="PassiveSearchBox" Style="{StaticResource DarkBox}" FontSize="10.5"
                                                 Padding="6,4" TextChanged="PassiveSearchChanged"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="PassivesOrderPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 3. ПРЕДМЕТИ (Ctrl+C) + TRADE 2 + ЛУТОФІЛЬТР (AI / Файл) -->
                    <Grid x:Name="PageItems" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Перемикач підвкладок -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                            <Button x:Name="BtnSubItemsEval" Content="Перевірка Ctrl+C" Style="{StaticResource BrassButton}"
                                    FontSize="10.5" Padding="10,4" Margin="0,0,6,0" Click="ShowItemsEvalSubtab_Click"/>
                            <Button x:Name="BtnSubLootFilter" Content="Лутофільтр (.filter / AI)" Style="{StaticResource FlatButton}"
                                    FontSize="10.5" Padding="10,4" Click="ShowLootFilterSubtab_Click"/>
                        </StackPanel>

                        <!-- Підвкладка 3а: Оцінка предметів -->
                        <Grid x:Name="ItemsEvalPanel" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,7">
                                <WrapPanel>
                                    <CheckBox x:Name="ChkAutoClipboard" Content="Авто Ctrl+C" IsChecked="True" Style="{StaticResource DarkCheck}" Margin="0,0,8,2"/>
                                    <CheckBox x:Name="ChkToastPopup" Content="Тост" IsChecked="True" Style="{StaticResource DarkCheck}" Margin="0,0,8,2"/>
                                    <CheckBox x:Name="ChkSoundAlert" Content="Звук" IsChecked="True" Style="{StaticResource DarkCheck}" Margin="0,0,8,2"/>
                                    <Button x:Name="BtnCheckClipboard" Content="Перевірити" Style="{StaticResource FlatButton}"
                                            Foreground="#FF69ACEC" FontSize="10" Padding="7,2" Margin="0,0,4,0" Click="CheckClipboardNow_Click"/>
                                    <Button x:Name="BtnEquipWornSlot" Content="Це на мені" Style="{StaticResource FlatButton}"
                                            Foreground="#FF4ECF8F" BorderBrush="#FF2A5A44" FontSize="10" Padding="7,2" Margin="0,0,4,0" Click="EquipCopiedItemToSlot_Click"/>
                                    <Button x:Name="BtnTradeLastItem" Content="Trade2" Style="{StaticResource BrassButton}"
                                            FontSize="10" Padding="7,2" Margin="0,0,4,0" Click="TradeLastItem_Click"/>
                                    <Button x:Name="BtnOpenTradeHelper" Content="Трейди" Style="{StaticResource FlatButton}"
                                            Foreground="#FFC8A462" FontSize="10" Padding="7,2" Click="OpenTradeHelper_Click"/>
                                </WrapPanel>
                            </Border>

                            <Border x:Name="ItemVerdictBorder" Grid.Row="1" Background="#FF191E28" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="9,7" Margin="0,0,0,6">
                                <TextBlock x:Name="ItemVerdictText" Text="Наведи на предмет у PoE 2 і натисни Ctrl+C"
                                           Foreground="#FF848B98" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="9" Margin="0,0,0,6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ItemDetailsPanel">
                                        <WrapPanel Margin="0,0,0,5">
                                            <Border x:Name="ItemUpgradeBadge" Background="#FF192638" BorderBrush="#FF344D70"
                                                    BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="0,0,5,4" Visibility="Collapsed">
                                                <TextBlock x:Name="ItemUpgradeBadgeText" Foreground="#FF69ACEC" FontWeight="SemiBold" FontSize="10.5"/>
                                            </Border>
                                            <Border x:Name="ItemPriceBadge" Background="#FF13261E" BorderBrush="#FF2A5A44"
                                                    BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="0,0,5,4" Visibility="Collapsed">
                                                <TextBlock x:Name="ItemPriceBadgeText" Foreground="#FF4ECF8F" FontWeight="SemiBold" FontSize="10.5"/>
                                            </Border>
                                            <Border x:Name="ItemProfitBadge" Background="#FF1E1A11" BorderBrush="#FF7A6338"
                                                    BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock x:Name="ItemProfitBadgeText" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock x:Name="ItemDetailsText" Foreground="#FFE4DFD5" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>

                                        <!-- Інтерактивні чекбокси модів для точного прайс-чеку (PoE Overlay II Alt+E стиль) -->
                                        <Border x:Name="ItemModFilterBox" Background="#FF0F1115" BorderBrush="#FF2A3140"
                                                BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="LblModFiltersTitle" Text="Прайс-чек за вибраними модами:"
                                                           Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="9.5" Margin="0,0,0,4"/>
                                                <StackPanel x:Name="ItemModChecksPanel" Margin="0,0,0,5"/>
                                                <WrapPanel>
                                                    <Button x:Name="BtnRecheckPriceByMods" Content="Ціна по модах" Style="{StaticResource BrassButton}"
                                                            FontSize="9.5" Padding="8,3" Margin="0,0,5,0" Click="RecheckPriceByMods_Click"/>
                                                    <Button x:Name="BtnOpenTradeByMods" Content="Відкрити Trade 2" Style="{StaticResource FlatButton}"
                                                            Foreground="#FF69ACEC" FontSize="9.5" Padding="8,3" Click="OpenTradeByMods_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="3" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="8,6">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="LblTradeTitle" Text="POE 2 TRADE ТА REGEX ПОШУК" Foreground="#FFC8A462" FontWeight="SemiBold" FontSize="9.5" VerticalAlignment="Center"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnCopyVendorRegex" Content="Regex Торгівля" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="6,2" Margin="0,0,4,0" Click="CopyVendorRegex_Click"/>
                                            <Button x:Name="BtnCopyWaystoneRegex" Content="Regex Мап" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="6,2" Margin="0,0,6,0" Click="CopyWaystoneRegex_Click"/>
                                            <TextBlock x:Name="LblLeague" Text="League:" Foreground="#FF848B98" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="TradeLeagueBox" Style="{StaticResource DarkBox}" Width="95" Padding="5,1" FontSize="9.5" Text="Forbidden Rites"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel x:Name="TradeButtonsPanel"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Підвкладка 3б: AI-генератор лутофільтру & підвантаження .filter -->
                        <Grid x:Name="LootFilterPanel" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FF13151B" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="9" Margin="0,0,0,7">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="LblFilterInstalled" Text="Фільтри в PoE 2:" Foreground="#FF848B98" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                                        <Button x:Name="FilterTypeBtn" Content="Режим вводу" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                Style="{StaticResource FlatButton}" FontSize="9.5" Padding="8,2" Click="ToggleTyping_Click"/>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblFilterName" Text="Файл:" Foreground="#FF848B98" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FilterNameBox" Grid.Column="2" Style="{StaticResource DarkBox}" FontSize="10" Padding="6,3" Text="Custom_Build"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnStrict1" Content="1 Starter" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,3" Margin="0,0,3,0" Click="SetFilterStrict1_Click"/>
                                            <Button x:Name="BtnStrict2" Content="2 Maps" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,3" Margin="0,0,3,0" Click="SetFilterStrict2_Click"/>
                                            <Button x:Name="BtnStrict3" Content="3 Strict" Style="{StaticResource BrassButton}" FontSize="9.5" Padding="7,3" Margin="0,0,3,0" Click="SetFilterStrict3_Click"/>
                                            <Button x:Name="BtnStrict4" Content="4 Uber" Style="{StaticResource FlatButton}" FontSize="9.5" Padding="7,3" Click="SetFilterStrict4_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FilterPromptBox" Grid.Column="0" Style="{StaticResource DarkBox}" FontSize="10" Padding="6,4"
                                                 ToolTip="Extra filter notes (e.g. highlight ilvl 80+ specific bases)"/>
                                        <Button x:Name="BtnAiGenerateFilter" Grid.Column="2" Content="AI-генерувати" Style="{StaticResource BrassButton}"
                                                FontSize="10" Padding="9,4" Click="GenerateFilterWithAi_Click"/>
                                        <Button x:Name="BtnLoadCustomFilter" Grid.Column="4" Content="Завантажити .filter" Style="{StaticResource FlatButton}"
                                                Foreground="#FF69ACEC" FontSize="10" Padding="8,4" Click="InstallFilter_Click"/>
                                        <Button x:Name="BtnSaveFilterToGame" Grid.Column="6" Content="Зберегти в PoE 2" Style="{StaticResource FlatButton}"
                                                Foreground="#FF4ECF8F" FontSize="10" Padding="8,4" Click="SaveFilterEditorToGame_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="FilterStatusText" Grid.Row="1" Text="Без вбудованого фільтру: згенеруй під білд через AI або завантаж власний .filter."
                                       Foreground="#FF848B98" FontSize="10.5" Margin="2,0,0,5" TextWrapping="Wrap"/>

                            <Border Grid.Row="2" Background="#FF0F1218" BorderBrush="#FF22252E"
                                    BorderThickness="1" CornerRadius="2" Padding="6">
                                <TextBox x:Name="FilterEditorBox" Background="Transparent" BorderThickness="0"
                                         Foreground="#FFE4DFD5" CaretBrush="#FFC8A462" FontFamily="Consolas" FontSize="10.5"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 4. ПЛАНУВАЛЬНИК (.build лише з папки PoE 2 BuildPlanner) -->
                    <Grid x:Name="PagePlanner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel x:Name="PlannerFilesPanel" Grid.Row="0" Margin="0,0,0,5"/>

                        <Border Grid.Row="1" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="9,6" Margin="0,0,0,7">
                            <DockPanel>
                                <CheckBox x:Name="ChkPlannerFilterByLevel" Content="Фільтр за моїм рівнем (level_interval)"
                                          IsChecked="True" Style="{StaticResource DarkCheck}"
                                          Checked="PlannerFilterChanged" Unchecked="PlannerFilterChanged"/>
                                <TextBlock x:Name="PlannerMetaText" Text="" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right" Foreground="#FFC8A462" FontSize="10.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#FF13151B" BorderBrush="#FF22252E"
                                BorderThickness="1" CornerRadius="2" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PlannerCardsPanel"/>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnImportBuildFiles" Grid.Column="0" Content="+ Файли .build" Style="{StaticResource BrassButton}"
                                    FontSize="10" Click="ImportBuildFilesToPlanner_Click"/>
                            <Button x:Name="BtnImportBuildFolder" Grid.Column="2" Content="+ З папки" Style="{StaticResource FlatButton}"
                                    Foreground="#FF69ACEC" FontSize="10" Click="ImportBuildFolderToPlanner_Click"/>
                            <Button x:Name="BtnPlannerMakeProfile" Grid.Column="4" Content="В активний білд" Style="{StaticResource FlatButton}"
                                    Foreground="#FF4ECF8F" FontSize="10" Click="ImportFromGamePlannerFolder_Click"/>
                            <Button x:Name="BtnOpenPlannerDir" Grid.Column="6" Content="Папка гри" Style="{StaticResource FlatButton}"
                                    FontSize="10" Click="OpenBuildPlannerFolder_Click"/>
                            <Button x:Name="BtnReloadBuilds" Grid.Column="8" Content="↻" Style="{StaticResource FlatButton}"
